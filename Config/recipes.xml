<configs>
	<append xpath="/recipes">

		<recipe name="HSSideLiftHandbook" count="1">
			<ingredient name="resourcePaper" count="1"/>
		</recipe>

		<!-- Button panels: same gating as the vanilla switch (workbench, Advanced Engineering, electrician unlock on the block). -->
		<recipe name="HSSideLiftOutsidePanel" count="1" craft_area="workbench" tags="perkAdvancedEngineering,learnable">
			<ingredient name="resourceForgedIron" count="4"/>
			<ingredient name="resourceMechanicalParts" count="2"/>
			<ingredient name="resourceElectricParts" count="2"/>
		</recipe>
		<recipe name="HSSideLiftOutsidePanelHalfBlock" count="1" craft_area="workbench" tags="perkAdvancedEngineering,learnable">
			<ingredient name="resourceForgedIron" count="4"/>
			<ingredient name="resourceMechanicalParts" count="2"/>
			<ingredient name="resourceElectricParts" count="2"/>
		</recipe>
		<recipe name="HSSideLiftOutsidePanelTenthBlock" count="1" craft_area="workbench" tags="perkAdvancedEngineering,learnable">
			<ingredient name="resourceForgedIron" count="4"/>
			<ingredient name="resourceMechanicalParts" count="2"/>
			<ingredient name="resourceElectricParts" count="2"/>
		</recipe>

		<recipe name="HSSideLiftInsidePanel" count="1" craft_area="workbench" tags="perkAdvancedEngineering,learnable">
			<ingredient name="resourceForgedIron" count="4"/>
			<ingredient name="resourceMechanicalParts" count="2"/>
			<ingredient name="resourceElectricParts" count="2"/>
		</recipe>
		<recipe name="HSSideLiftInsidePanelHalfBlock" count="1" craft_area="workbench" tags="perkAdvancedEngineering,learnable">
			<ingredient name="resourceForgedIron" count="4"/>
			<ingredient name="resourceMechanicalParts" count="2"/>
			<ingredient name="resourceElectricParts" count="2"/>
		</recipe>
		<recipe name="HSSideLiftInsidePanelPlateOffset" count="1" craft_area="workbench" tags="perkAdvancedEngineering,learnable">
			<ingredient name="resourceForgedIron" count="4"/>
			<ingredient name="resourceMechanicalParts" count="2"/>
			<ingredient name="resourceElectricParts" count="2"/>
		</recipe>

		<recipe name="HSSideLiftTool" count="1" craft_area="workbench" tags="perkAdvancedEngineering,learnable">
			<ingredient name="resourceForgedIron" count="4"/>
			<ingredient name="resourceMechanicalParts" count="2"/>
			<ingredient name="resourceElectricParts" count="2"/>
		</recipe>

		<!-- Vanilla elevator doors (optional for a working lift). -->
		<recipe name="elevatorDoor" count="1" craft_area="workbench" tags="workbenchCrafting">
			<ingredient name="resourceForgedIron" count="15"/>
			<ingredient name="resourceSpring" count="2"/>
			<ingredient name="resourceMechanicalParts" count="4"/>
		</recipe>
		<recipe name="elevatorDoorTenthBlock" count="1" craft_area="workbench" tags="workbenchCrafting">
			<ingredient name="resourceForgedIron" count="15"/>
			<ingredient name="resourceSpring" count="2"/>
			<ingredient name="resourceMechanicalParts" count="4"/>
		</recipe>
		<recipe name="elevatorDoorDouble" count="1" craft_area="workbench" tags="workbenchCrafting">
			<ingredient name="resourceForgedIron" count="30"/>
			<ingredient name="resourceSpring" count="4"/>
			<ingredient name="resourceMechanicalParts" count="8"/>
		</recipe>

	</append>
</configs>
